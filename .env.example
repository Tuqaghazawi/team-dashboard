# Copy this file to .env and fill in the values.
# .env is gitignored and must NEVER be committed.

# OpenAI API key for the AI layer (ai/).
OPENAI_API_KEY=

# Django secret key. Generate a fresh one for any real deployment.
DJANGO_SECRET_KEY=

# Set to False in production.
DEBUG=True

# Email. Leave EMAIL_HOST empty to print notification emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=surgical-oncology-dashboard@khcc.jo

# Base URL used for patient links inside notification emails.
SITE_URL=http://127.0.0.1:8000
