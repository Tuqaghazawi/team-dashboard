# Render builds on Linux. A shell script committed with CRLF endings fails with
# "bad interpreter", so pin these regardless of the machine that commits them.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary — never touch the line endings.
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.sqlite3 binary
*.db binary
